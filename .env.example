# Copy to .env and adjust. All vars are prefixed RIL_ per app.core.config.Settings.
RIL_ENVIRONMENT=development
RIL_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ril_o2c
RIL_RANDOM_SEED=42
# synthetic (default, offline, deterministic — used by tests) | live (real crude/gas/propane/FX
# from EIA + frankfurter.dev, synthetic fallback for the rest — see data/adapters/live_market.py)
RIL_DATA_SOURCE_MODE=synthetic
# Free api.data.gov shared key works out of the box at low rate limits. Get your own free key
# in ~30s at https://www.eia.gov/opendata/register.php for reliable production use.
RIL_EIA_API_KEY=DEMO_KEY
RIL_MC_DEFAULT_SCENARIOS=10000
RIL_FORECAST_DEFAULT_HORIZON_DAYS=90
RIL_BACKTEST_MIN_TRAIN_DAYS=365
RIL_LOG_LEVEL=INFO
RIL_CORS_ALLOW_ORIGIN_REGEX=http://localhost:\d+|https://.*\.vercel\.app
